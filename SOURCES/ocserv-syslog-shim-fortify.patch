tests: make syslog-shim also intercept __syslog_chk()

With -D_FORTIFY_SOURCE (the default in distribution builds, e.g. RPM's
%optflags) glibc redirects syslog(3) calls to __syslog_chk(), so the
LD_PRELOAD shim's syslog() hook never runs and test-cert-opt-pass fails
with "Missing optional certificate was not logged at all!".

Factor the recording into a helper and add a __syslog_chk() hook.

--- a/tests/syslog-shim.c
+++ b/tests/syslog-shim.c
@@ -92,34 +92,57 @@
 		real_openlog(ident, logopt, facility);
 }
 
-void syslog(int priority, const char *format, ...)
+static void record(int priority, const char *format, va_list args)
 {
 	const char *out;
 	char msg[1024];
 	char line[1200];
-	va_list args;
 	int fd, len;
 
 	out = getenv("SYSLOG_SHIM_OUT");
-	if (out != NULL) {
-		va_start(args, format);
-		vsnprintf(msg, sizeof(msg), format, args);
-		va_end(args);
+	if (out == NULL)
+		return;
 
-		len = snprintf(line, sizeof(line), "MSG %d %s\n", priority,
-			       msg);
-		if (len > 0 && (size_t)len > sizeof(line) - 1)
-			len = sizeof(line) - 1;
+	vsnprintf(msg, sizeof(msg), format, args);
 
-		fd = open(out, O_WRONLY | O_CREAT | O_APPEND, 0600);
-		if (fd >= 0) {
-			write(fd, line, len);
-			close(fd);
-		}
+	len = snprintf(line, sizeof(line), "MSG %d %s\n", priority, msg);
+	if (len > 0 && (size_t)len > sizeof(line) - 1)
+		len = sizeof(line) - 1;
+
+	fd = open(out, O_WRONLY | O_CREAT | O_APPEND, 0600);
+	if (fd >= 0) {
+		write(fd, line, len);
+		close(fd);
 	}
+}
 
+void syslog(int priority, const char *format, ...)
+{
+	va_list args;
+
+	va_start(args, format);
+	record(priority, format, args);
+	va_end(args);
+
 	/* vsyslog(3) is not intercepted, so this reaches the real syslog. */
 	va_start(args, format);
 	vsyslog(priority, format, args);
 	va_end(args);
 }
+
+/* With -D_FORTIFY_SOURCE (the default in distribution builds) glibc routes
+ * syslog(3) calls to __syslog_chk(), which bypasses the syslog() hook above. */
+void __syslog_chk(int priority, int flag, const char *format, ...);
+void __syslog_chk(int priority, int flag, const char *format, ...)
+{
+	va_list args;
+
+	(void)flag;
+	va_start(args, format);
+	record(priority, format, args);
+	va_end(args);
+
+	va_start(args, format);
+	vsyslog(priority, format, args);
+	va_end(args);
+}
